{
  "name": "calendar-event-insert",
  "request": {
    "method": "POST",
    "urlPathPattern": "/calendar/v3/calendars/[^/]+/events"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=UTF-8",
      "Access-Control-Allow-Origin": "*"
    },
    "transformers": ["response-template"],
    "bodyFileName": "calendar-event-written.hbs"
  }
}
