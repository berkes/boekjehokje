{
  "tasks": {
    "test:e2e": "deno run -A npm:@playwright/test test --config e2e/playwright.config.ts",
    "test:google-mock": "docker run --rm -p 8081:8080 -v ./e2e/wiremock:/home/wiremock wiremock/wiremock:3x"
  },
  "fmt": {
    "exclude": [
      "public/**/*.svg",
      "src/assets/**/*.svg",
      "src/services/DemoCalendarAdapter.ts"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.21"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "deno.ns"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  }
}
